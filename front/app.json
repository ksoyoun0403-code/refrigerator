{
  "expo": {
    "name": "mydish",
    "slug": "mydish",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "io.github.ksoyoun0403code.mydish",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "유통기한을 인식할 식품 사진을 선택하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "유통기한을 인식할 식품 사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      "expo-splash-screen"
    ]
  }
}
