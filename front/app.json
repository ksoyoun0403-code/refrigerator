{
  "expo": {
    "name": "mydish",
    "slug": "mydish",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "io.github.ksoyoun0403code.mydish",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE",
        "foregroundImage": "./assets/app-icon-foreground.png"
      },
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "유통기한을 인식할 식품 사진을 선택하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "유통기한을 인식할 식품 사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      "expo-splash-screen",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "861b1fec-0f78-42d5-93af-35c20e526ef3"
      }
    },
    "owner": "soso_04",
    "updates": {
      "url": "https://u.expo.dev/861b1fec-0f78-42d5-93af-35c20e526ef3"
    }
  }
}
