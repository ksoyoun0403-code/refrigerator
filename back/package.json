{
  "name": "mydish-back",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --watch --watch-preserve-output --env-file-if-exists=.env -r ts-node/register src/main.ts",
    "pretypecheck": "npm run prisma:generate",
    "test:date-parser": "npm run build && node scripts/test-expiration-date-parser.cjs",
    "test:recipe-suggestions": "npm run build && node scripts/test-recipe-suggestions.cjs",
    "test:saved-recipes": "npm run build && node scripts/test-saved-recipes.cjs",
    "test:auth": "npm run build && node scripts/test-auth.cjs",
    "test:user-profile": "npm run build && node --env-file=.env scripts/test-user-profile.cjs",
    "test:community-models": "npm run build && node --env-file=.env scripts/test-community-models.cjs",
    "test:recipe-posts": "npm run build && node --env-file=.env scripts/test-recipe-posts.cjs",
    "test:recipe-comments": "npm run build && node --env-file=.env scripts/test-recipe-comments.cjs",
    "test:recipe-consumptions": "npm run build && node --env-file=.env scripts/test-recipe-consumptions.cjs",
    "test:image-preprocessor": "npm run build && node scripts/test-image-preprocessor.cjs",
    "test:ocr": "npm run build && node scripts/test-ocr.cjs",
    "test:vision": "npm run build && node --env-file=.env scripts/test-google-vision-ocr.cjs",
    "test:vision-fixtures": "npm run build && node --env-file=.env scripts/test-google-vision-fixtures.cjs",
    "test:vision-response": "npm run build && node scripts/test-google-vision-response.cjs",
    "test:database": "npm run build && node --env-file=.env scripts/test-database-integration.cjs",
    "verify:core": "npm --prefix ../front run typecheck && npm run typecheck && npm run test:auth && npm run test:user-profile && npm run test:database && npm run test:community-models && npm run test:recipe-posts && npm run test:recipe-comments && npm run test:recipe-consumptions && npm run test:recipe-suggestions && npm run test:saved-recipes",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
